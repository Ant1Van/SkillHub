{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SkillHub",
  "version": "0.2.1",
  "identifier": "com.skillhub.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SkillHub",
        "width": 380,
        "height": 560,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://api.github.com https://raw.githubusercontent.com;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3NTAxRURDM0E1RTU3Q0IKUldUTFYxNDYzQjVRVjJNVGl3Q3EvbWJVSkh3OHVrd1d2RG5xQUJQTmRoc3FrYW1CNittcGhlRXIK",
      "endpoints": [
        "https://github.com/Ant1Van/SkillHub/releases/latest/download/latest.json"
      ]
    }
  }
}
